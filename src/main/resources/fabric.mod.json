{
  "schemaVersion": 1,
  "id": "ghostpath",
  "version": "${version}",
  "name": "Ghost Path",
  "description": "Shows where TNT and projectiles will go, as a live path in the world.",
  "authors": ["obsidivision"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["obsidivision.ghostpath.GhostPath"],
    "client": ["obsidivision.ghostpath.client.GhostPathClient"]
  },
  "mixins": [
    "ghostpath.mixins.json",
    { "config": "ghostpath.client.mixins.json", "environment": "client" }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
